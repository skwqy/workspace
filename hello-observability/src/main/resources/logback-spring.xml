<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志落地的核心决定：
  1) 控制台给人看（带 trace_id/span_id 的彩色排版）；文件给机器看（JSON，一行一条）。
  2) trace_id / span_id / trace_flags 三个 MDC key 由 opentelemetry-javaagent 自动注入，
     业务代码一行都不用写 —— 这是"日志能和链路对上号"的根本原因。
  3) JSON 文件由 Filebeat 以 filestream + ndjson 采集，往下游 Kafka → Logstash → ES。
-->
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <springProperty scope="context" name="APP_ENV" source="app.env" defaultValue="local"/>

    <!-- 日志目录：本机跑是 ./logs，容器里由环境变量覆盖成 /var/log/app -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%magenta(%X{trace_id:-})/%X{span_id:-}] [%thread] %cyan(%logger{28}) - %msg%n"/>

    <!-- ① 人看的：控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ② 机器看的：JSON 滚动文件 -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>Asia/Shanghai</timeZone>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <!-- 把 MDC 整体平铺到 JSON 顶层：trace_id / span_id / trace_flags 就是从这里来的 -->
            <includeMdc>true</includeMdc>
            <includeContext>false</includeContext>
            <includeTags>false</includeTags>
            <!-- SLF4J 2 的 fluent API（log.atInfo().addKeyValue(...)）产生的字段也平铺进来 -->
            <includeKeyValuePairs>true</includeKeyValuePairs>
            <customFields>{"service":"${APP_NAME}","env":"${APP_ENV}","service_version":"0.0.1"}</customFields>
            <fieldNames>
                <!-- 刻意不叫 @timestamp：让"应用时间"和 filebeat 的"采集时间"两个字段并存，
                     由 Logstash 的 date 过滤器把应用时间提升为 @timestamp（见 logstash/pipeline/*.conf） -->
                <timestamp>log_timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <stackTrace>error.stack_trace</stackTrace>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>20</maxDepthPerThrowable>
                <maxLength>4096</maxLength>
                <shortenedClassNameLength>32</shortenedClassNameLength>
                <exclude>^java\.lang\.Thread\.run$</exclude>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ③ 异步包装：业务线程写队列即返回，避免磁盘/网络抖动阻塞请求。
         discardingThreshold=0 表示队列满时"阻塞而不是丢日志"——可观测性数据宁可慢，不可缺。 -->
    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <includeCallerData>true</includeCallerData>
        <appender-ref ref="JSON_FILE"/>
    </appender>

    <!-- 本地开发想只看控制台，可以用 -Dspring.profiles.active=console 关掉文件输出 -->
    <springProfile name="console">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!console">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>
</configuration>
