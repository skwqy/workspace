<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>hello-observability</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>hello-observability</name>
    <description>可观测性三支柱样例：Micrometer/Prometheus pull + OTel Agent 链路 + Logback→Filebeat→Kafka→Logstash→ES→Kibana</description>

    <properties>
        <java.version>25</java.version>
        <!-- 日志结构化编码器：输出 JSON 到文件，供 Filebeat 采集 -->
        <logstash-encoder.version>8.1</logstash-encoder.version>
        <!-- 只做编译期 API 依赖；运行时由 opentelemetry-javaagent 2.33.1 提供实现 -->
        <opentelemetry.version>1.67.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>2.33.1</opentelemetry-instrumentation.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- @Observed / @Timed / @Counted 走 AOP 织入，必须 aspectjweaver 在 classpath。
             ⚠️ Boot 4 把 spring-boot-starter-aop 改名为 spring-boot-starter-aspectj（老名已不被 BOM 管理，写上会报 version missing） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 指标：Prometheus pull 模式的 Registry（暴露 /actuator/prometheus 文本格式） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 日志：把 Logback event 编码成 JSON（一行一条），filebeat 直接按 ndjson 解析 -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-encoder.version}</version>
        </dependency>

        <!-- 链路：只用 OTel API 手工埋点（SDK/导出全部由 javaagent 提供，pom 里不引 SDK） -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <!-- @WithSpan / @SpanAttribute 注解，运行时由 agent 的 annotations 插桩织入（不需要 AspectJ） -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-instrumentation-annotations</artifactId>
            <version>${opentelemetry-instrumentation.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- opentelemetry-api 的版本由 OTel BOM 统一管理（Boot 4 的 BOM 不管理 OTel 运行时） -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
